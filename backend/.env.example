# Copy to your shell / hosting provider's environment. Never commit real values.
APP_ENV=development
PORT=8080
MONGO_URI=mongodb://localhost:27017
MONGO_DB=livepoll
REDIS_URL=redis://localhost:6379
# At least 32 random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string-0123456789
# Optional: serve the built frontend from Go (production does this)
# STATIC_DIR=../frontend/dist
